# ===================================================================
# RUMULI CORPORATE - FIREBASE BACKEND CONFIGURATION
# ===================================================================
# Instructions:
# 1. Create a project at https://console.firebase.google.com/
# 2. Enable Authentication (Email/Password provider)
# 3. Enable Cloud Firestore database (in production or test mode)
# 4. Enable Firebase Storage (for receipt and document attachments)
# 5. Copy your web app config values below and save as ".env"
# ===================================================================

VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=rumuli-corporate.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=rumuli-corporate
VITE_FIREBASE_STORAGE_BUCKET=rumuli-corporate.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
